{
  "name": "audit-system-frontend",
  "version": "1.0.0",
  "description": "AI-Powered Document Audit System Frontend",
  "private": true,
  "dependencies": {
    "axios": "^1.4.0",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.0",
    "zustand": "^4.3.9"
  },
  "scripts": {
    "dev": "npm run verify:css && craco start",
    "start": "npm run verify:css && craco start",
    "build": "npm run verify:css && craco build",
    "test": "craco test",
    "eject": "react-scripts eject",
    "verify:css": "node scripts/verify-css-setup.js",
    "fix:css": "node scripts/clear-webpack-cache.js && npm run verify:css"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.24",
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.3.2"
  }
}
